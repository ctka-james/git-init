#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMMITLINT_CONFIG="$HOME/.config/git/commitlint.config.cjs"
HOOK_DIR="$HOME/.config/git/hooks"
HOOK_FILE="$HOOK_DIR/commit-msg"
COMMIT_TEMPLATE="$HOME/.config/git/commit-template.txt"

ensure_git_identity() {
    local user_name=""
    local user_email=""

    if ! git config --global --get user.name >/dev/null 2>&1; then
        while [ -z "$user_name" ]; do
            read -r -p "請輸入 Git user.name：" user_name
        done
        git config --global user.name "$user_name"
    fi

    if ! git config --global --get user.email >/dev/null 2>&1; then
        while [ -z "$user_email" ]; do
            read -r -p "請輸入 Git user.email：" user_email
        done
        git config --global user.email "$user_email"
    fi
}

cleanup() {
    if [ $? -ne 0 ]; then
        echo
        echo "❌ 安裝或初始化流程失敗，請檢查錯誤訊息。"
    fi
}
trap cleanup EXIT

echo "===================================="
echo " Git Repository Initialization"
echo "===================================="

if ! command -v npm >/dev/null 2>&1; then
    echo "❌ 未偵測到 npm，請先安裝 Node.js 與 npm 後再執行此工具。"
    exit 1
fi

if command -v commitlint >/dev/null 2>&1; then
    echo "▶ Commitlint 已安裝：$(commitlint --version)"
else
    echo "▶ Installing Commitlint globally..."
    npm install -g @commitlint/cli @commitlint/config-conventional
fi

mkdir -p "$HOME/.config/git"

if [ ! -f "$COMMITLINT_CONFIG" ]; then
    echo "▶ Creating commitlint config..."
    cat > "$COMMITLINT_CONFIG" <<'EOF'
module.exports = {
    extends: ['@commitlint/config-conventional']
};
EOF
fi

mkdir -p "$HOOK_DIR"

if [ ! -f "$HOOK_FILE" ]; then
    echo "▶ Creating commit-msg hook..."
    cat > "$HOOK_FILE" <<'EOF'
#!/bin/sh
commitlint --config ~/.config/git/commitlint.config.cjs --edit "$1"
EOF
    chmod +x "$HOOK_FILE"
fi

git config --global core.hooksPath "$HOOK_DIR"

if [ ! -f "$COMMIT_TEMPLATE" ]; then
    if [ -f "$SCRIPT_DIR/.gitmessage" ]; then
        cp "$SCRIPT_DIR/.gitmessage" "$COMMIT_TEMPLATE"
    else
        cat > "$COMMIT_TEMPLATE" <<'EOF'
type(scope): subject

# 描述：
# - why
# - what

# Footer (Optional)
#
# BREAKING CHANGE:

# feat(auth): add JWT authentication
#
# Types:
# feat     新功能
# fix      修正 Bug
# docs     文件
# style    格式調整
# refactor 重構
# perf     效能改善
# test     測試
# build    建置
# ci       CI/CD
# chore    維護
# revert   回復 Commit
#
# ------------------------------------------
# Commit Subject first word
# add		新增、加入 | 新增檔案、功能、方法、欄位等
# register	註冊 | 將某個功能或物件註冊到系統中
# update	更新 | 某個檔案更新時使用
# implement	實作、實現 | 完成某個功能的實際邏輯
# remove	移除、刪除 | 刪除功能、程式碼、設定
# rename	重新命名、更名 | 修改名稱，不改功能
# support	支援、新增支援 | 增加對某項功能或平台的支援
EOF
    fi
fi

git config --global commit.template "$COMMIT_TEMPLATE"

if ! git config --global --get core.editor >/dev/null 2>&1; then
    git config --global core.editor "vim"
fi

# 檢查是否已初始化 Git
if [ -d ".git" ]; then
    echo "❌ 此目錄已經是 Git Repository"
    exit 1
fi

echo "▶ Initializing Git..."
git init -b main

echo "▶ Checking repository contents..."

if [ -f .gitignore ]; then
    echo "▶ Existing .gitignore found. Keeping the current file."
elif [ -n "$(find . -mindepth 1 -maxdepth 1 ! -name .git -print -quit)" ]; then
    echo "▶ Directory already contains files. Skipping .gitignore creation to preserve existing project contents."
else
    echo "▶ Creating .gitignore..."
    cat > .gitignore <<'EOF'
# -------------------------
# OS
# -------------------------
.DS_Store
Thumbs.db

# -------------------------
# IDE
# -------------------------
.vscode/
.idea/

# -------------------------
# Logs
# -------------------------
*.log

# -------------------------
# Temp
# -------------------------
tmp/
temp/

# -------------------------
# Composer
# -------------------------
vendor/

# -------------------------
# Node
# -------------------------
node_modules/
npm-debug.log*

# -------------------------
# Environment
# -------------------------
.env
.env.*

# -------------------------
# Misc
# -------------------------
*.swp
*.swo
EOF
fi

mkdir -p docs

ensure_git_identity

echo "▶ Creating first commit..."
INITIAL_COMMIT_MSG="chore: initial commit"
git add .
git commit -m "$INITIAL_COMMIT_MSG"

echo "▶ Creating development branches..."
git branch develop
git branch feat
git branch docs
git checkout feat

echo
echo "===================================="
echo " Repository Created Successfully"
echo "===================================="
echo
git branch

echo
echo "===================================="
echo " git config --global --list"
echo "===================================="
echo
git config --global --list
