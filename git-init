#!/usr/bin/env bash
# git-init v2：預設唯讀的專案本機 Git bootstrap。
set -euo pipefail

readonly EXIT_USAGE=2 EXIT_BLOCKER=3 EXIT_RISK=4 EXIT_CONFLICT=5 EXIT_PARTIAL=6
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
TARGET_DIR="$(pwd -P)"
MODE=check
USER_NAME=""
USER_EMAIL=""
MUTATIONS=()
ISSUES=()
ISSUE_CODE=0
EXISTING_REPO=0
HAS_HEAD=0
ORIGINAL_CLEAN=1
HAVE_GIT=0
LOCAL_NAME=""
LOCAL_EMAIL=""
EFFECTIVE_NAME=""
EFFECTIVE_EMAIL=""
WORKTREE_STATUS=NO_REPO
WORKTREE_SCOPE=none
RECEIPT_DISPOSITIONS=()
VENDOR_VALID=0
readonly RECEIPT=.git/git-init-v2-receipt
readonly RECEIPT_MARKER=.git/git-init-v2-receipt.sha256
readonly MANAGED_PATHS=(.gitmessage commitlint.config.cjs AI-WORKFLOW.template.md .githooks/commit-msg .gitignore)

say() { printf '%s\n' "$*"; }
issue() {
  local code=$1 kind=$2 detail=$3
  ISSUES+=("$kind: $detail")
  (( code > ISSUE_CODE )) && ISSUE_CODE=$code
  say "$kind: $detail"
}
usage() {
  cat <<'EOF'
用法：git-init [--check|--dry-run|--init [--user-name 值 --user-email 值]]

預設與 --check 完全唯讀。--dry-run 顯示與 --init 相同的預計動作但不寫入。
--init 僅在所有 preflight blocker 清除後，建立 project-local 設定；不 add、commit、push、
checkout、merge、rebase、reset、fetch 或修改 global Git/npm 設定。
EOF
}
valid_text() {
  # Bash arguments cannot contain NUL；其餘控制字元在此拒絕。
  [[ -n $1 && $1 != *$'\n'* && $1 != *$'\r'* && $1 != *[[:cntrl:]]* ]]
}
valid_email() {
  valid_text "$1" && [[ $1 =~ ^[^[:space:]@]+@[^[:space:]@]+\.[^[:space:]@]+$ ]]
}
redact_url() {
  # 僅顯示 scheme/host/path；永不印出 userinfo、query 或 fragment。
  local value=$1 rest authority host path scheme
  value=${value%%\#*}; value=${value%%\?*}
  rest=${value#*://}
  if [[ $value != *://* ]]; then say '<非標準 remote URL>'; return; fi
  scheme=${value%%://*}; authority=${rest%%/*}; host=${authority##*@}; path=""
  [[ $rest == */* ]] && path=/${rest#*/}
  [[ -n $host ]] && say "${scheme}://${host}${path}" || say '<遮蔽的 remote URL>'
}
managed_same_or_conflict() {
  local target=$1 source=$2 label=$3
  if [[ -L $target ]]; then issue "$EXIT_RISK" RISK "$label 為 symlink，拒絕跟隨"; return; fi
  if [[ -e $target ]] && ! cmp -s -- "$target" "$source"; then
    issue "$EXIT_CONFLICT" CONFLICT "$label 已存在且內容不同，不覆寫"
  fi
  return 0
}
contains_source() {
  find . -mindepth 1 -maxdepth 1 ! -name .git -print -quit | grep -q .
}
template_for() {
  case $1 in
    .gitmessage) printf '%s\n' "$SCRIPT_DIR/.gitmessage" ;;
    commitlint.config.cjs) printf '%s\n' "$SCRIPT_DIR/commitlint.config.cjs" ;;
    AI-WORKFLOW.template.md) printf '%s\n' "$SCRIPT_DIR/AI-WORKFLOW.template.md" ;;
    .githooks/commit-msg) printf '%s\n' "$SCRIPT_DIR/.githooks/commit-msg" ;;
    .gitignore) printf '%s\n' "$SCRIPT_DIR/.gitignore" ;;
    *) return 1 ;;
  esac
}
receipt_allows() {
  local want=$1 version disposition path hash source marker_digest receipt_digest
  [[ -f $RECEIPT && ! -L $RECEIPT && -f $RECEIPT_MARKER && ! -L $RECEIPT_MARKER ]] || return 1
  marker_digest=$(<"$RECEIPT_MARKER")
  receipt_digest=$(sha256sum "$RECEIPT" | cut -d' ' -f1)
  [[ $marker_digest == "$receipt_digest" && $marker_digest =~ ^[a-f0-9]{64}$ ]] || return 1
  exec 9< "$RECEIPT"
  IFS= read -r version <&9 || { exec 9<&-; return 1; }
  [[ $version == 'git-init-v2-receipt-v1' ]] || { exec 9<&-; return 1; }
  while IFS=$'\t' read -r disposition path hash <&9; do
    [[ $disposition == CREATED && $path == "$want" && $hash =~ ^[a-f0-9]{64}$ ]] || continue
    source=$(template_for "$path") || { exec 9<&-; return 1; }
    if [[ -f $path && ! -L $path && $(sha256sum "$path" | cut -d' ' -f1) == "$hash" && $(sha256sum "$source" | cut -d' ' -f1) == "$hash" ]]; then exec 9<&-; return 0; fi
  done
  exec 9<&-
  return 1
}
receipt_preserves() {
  # A valid PRESERVED row records known user ownership.  It is deliberately
  # independent of the current bytes, unlike CREATED rows.
  local want=$1 version disposition path hash marker_digest receipt_digest
  [[ -f $RECEIPT && ! -L $RECEIPT && -f $RECEIPT_MARKER && ! -L $RECEIPT_MARKER ]] || return 1
  marker_digest=$(<"$RECEIPT_MARKER")
  receipt_digest=$(sha256sum "$RECEIPT" | cut -d' ' -f1)
  [[ $marker_digest == "$receipt_digest" && $marker_digest =~ ^[a-f0-9]{64}$ ]] || return 1
  exec 9< "$RECEIPT"
  IFS= read -r version <&9 || { exec 9<&-; return 1; }
  [[ $version == 'git-init-v2-receipt-v1' ]] || { exec 9<&-; return 1; }
  while IFS=$'\t' read -r disposition path hash <&9; do
    [[ $disposition == PRESERVED && $path == "$want" && $hash == - ]] && { exec 9<&-; return 0; }
  done
  exec 9<&-
  return 1
}
receipt_required() {
  local hooks template metadata
  [[ -e $RECEIPT || -L $RECEIPT || -e $RECEIPT_MARKER || -L $RECEIPT_MARKER ]] && return 0
  hooks=$(git config --local --get core.hooksPath 2>/dev/null || true)
  template=$(git config --local --get commit.template 2>/dev/null || true)
  metadata=$(find .git -maxdepth 1 -name 'git-init-v2-*' -print -quit 2>/dev/null || true)
  [[ $hooks == .githooks || $template == .gitmessage || -n $metadata ]]
}
check_receipt_integrity() {
  local version disposition path hash extra source digest marker_digest receipt_digest count=0 seen="" want
  (( EXISTING_REPO )) || return 0
  if [[ ! -e $RECEIPT && ! -L $RECEIPT ]]; then
    receipt_required && issue "$EXIT_CONFLICT" CONFLICT 'bootstrap receipt 缺失，拒絕將已初始化 repository 視為首次執行'
    return 0
  fi
  if [[ ! -f $RECEIPT || -L $RECEIPT ]]; then
    issue "$EXIT_CONFLICT" CONFLICT 'bootstrap receipt 非一般檔案或為 symlink，拒絕使用'
    return 0
  fi
  if [[ ! -e $RECEIPT_MARKER && ! -L $RECEIPT_MARKER ]]; then
    issue "$EXIT_CONFLICT" CONFLICT 'bootstrap receipt integrity marker 缺失；bootstrap state ambiguous/inconsistent，拒絕使用'
    return 0
  fi
  if [[ ! -f $RECEIPT_MARKER || -L $RECEIPT_MARKER ]]; then
    issue "$EXIT_CONFLICT" CONFLICT 'bootstrap receipt integrity marker 非一般檔案或為 symlink，拒絕使用'
    return 0
  fi
  marker_digest=$(<"$RECEIPT_MARKER")
  receipt_digest=$(sha256sum "$RECEIPT" | cut -d' ' -f1)
  if [[ $marker_digest != "$receipt_digest" || ! $marker_digest =~ ^[a-f0-9]{64}$ ]]; then
    issue "$EXIT_CONFLICT" CONFLICT 'bootstrap receipt integrity marker 不符，拒絕使用'
    return 0
  fi
  exec 9< "$RECEIPT"
  IFS= read -r version <&9 || true
  if [[ $version != 'git-init-v2-receipt-v1' ]]; then
    exec 9<&-
    issue "$EXIT_CONFLICT" CONFLICT 'bootstrap receipt schema 未支援或格式錯誤，拒絕隱式升級'
    return 0
  fi
  while IFS=$'\t' read -r disposition path hash extra <&9 || [[ -n $disposition || -n $path || -n $hash || -n $extra ]]; do
    if [[ -z $disposition || -z $path || -n $extra || $seen == *"|$path|"* ]]; then
      issue "$EXIT_CONFLICT" CONFLICT 'bootstrap receipt 格式錯誤或含重複 entry，拒絕使用'
      return 0
    fi
    source=$(template_for "$path") || { issue "$EXIT_CONFLICT" CONFLICT 'bootstrap receipt 含未知 managed path，拒絕使用'; return 0; }
    case $disposition in
      CREATED)
        [[ $hash =~ ^[a-f0-9]{64}$ ]] || { issue "$EXIT_CONFLICT" CONFLICT 'bootstrap receipt CREATED hash 格式錯誤，拒絕使用'; return 0; }
        if [[ ! -f $path || -L $path ]]; then issue "$EXIT_CONFLICT" CONFLICT "receipt 已記錄為 CREATED 的 $path 缺失或為 symlink，不重建"; return 0; fi
        digest=$(sha256sum "$path" | cut -d' ' -f1)
        if [[ $digest != "$hash" || $(sha256sum "$source" | cut -d' ' -f1) != "$hash" ]]; then issue "$EXIT_CONFLICT" CONFLICT "receipt 已記錄為 CREATED 的 $path 已修改或 template version 不符，不覆寫"; return 0; fi
        ;;
      PRESERVED)
        [[ $hash == - ]] || { issue "$EXIT_CONFLICT" CONFLICT 'bootstrap receipt PRESERVED entry 格式錯誤，拒絕使用'; return 0; }
        [[ -f $path && ! -L $path ]] || { issue "$EXIT_CONFLICT" CONFLICT "receipt 已記錄為 PRESERVED 的 $path 缺失或非一般檔案，不從 template 重建"; return 0; }
        ;;
      *) issue "$EXIT_CONFLICT" CONFLICT 'bootstrap receipt disposition 未支援，拒絕使用'; return 0 ;;
    esac
    seen+="|$path|"; count=$((count + 1))
  done
  exec 9<&-
  (( count == ${#MANAGED_PATHS[@]} )) || { issue "$EXIT_CONFLICT" CONFLICT 'bootstrap receipt 未列出全部 candidate path，拒絕使用'; return 0; }
  for want in "${MANAGED_PATHS[@]}"; do
    [[ $seen == *"|$want|"* ]] || { issue "$EXIT_CONFLICT" CONFLICT 'bootstrap receipt 不完整，拒絕使用'; return 0; }
  done
}
path_in_mutation_scope() {
  # A candidate itself, an ancestor that can change its type, or a descendant
  # that means a candidate is not an ordinary file is bootstrap state.  This
  # is classification only; receipt and type checks decide whether it blocks.
  local path=$1 candidate
  for candidate in "${MANAGED_PATHS[@]}"; do
    [[ $path == "$candidate" || $path == "$candidate/"* || $candidate == "$path/"* ]] && return 0
  done
  return 1
}
classify_worktree() {
  local s xy path dirty=0 scope=ordinary
  s=$(git --no-optional-locks status --porcelain=v1 --untracked-files=all 2>/dev/null || true)
  [[ -z $s ]] && { WORKTREE_STATUS=clean; WORKTREE_SCOPE=clean; ORIGINAL_CLEAN=1; return; }; ORIGINAL_CLEAN=0
  while IFS= read -r s; do
    xy=${s:0:2}; path=${s:3}
    dirty=1
    if path_in_mutation_scope "$path"; then
      # A receipt can prove an exact PRESERVED candidate remains user-owned,
      # or an unchanged CREATED candidate remains tool-owned.  Any other
      # dirty mutation-scope path is untrusted on this invocation.
      if receipt_preserves "$path" || { [[ $xy == '??' ]] && receipt_allows "$path"; }; then
        [[ $scope == ordinary ]] && scope=bootstrap-trusted
      else
        scope=bootstrap-untrusted
      fi
    fi
  done <<< "$s"
  (( dirty )) && WORKTREE_STATUS=dirty || WORKTREE_STATUS=clean
  WORKTREE_SCOPE=$scope
}
scan_file() {
  local file=$1 rel=$2 size line
  if [[ -L $file ]]; then
    if [[ ! -e $file || $(readlink -f -- "$file" 2>/dev/null || true) != "$TARGET_DIR"/* ]]; then
      issue "$EXIT_RISK" RISK "symlink 未掃描：$rel"
    else
      issue "$EXIT_RISK" RISK "symlink 未掃描：$rel"
    fi
    return
  fi
  [[ -r $file ]] || { issue "$EXIT_RISK" RISK "檔案無法讀取：$rel"; return; }
  size=$(wc -c < "$file" 2>/dev/null) || { issue "$EXIT_RISK" RISK "檔案無法讀取：$rel"; return; }
  if (( size > 1048576 )); then issue "$EXIT_RISK" RISK "大型檔案未掃描：$rel"; return; fi
  if LC_ALL=C od -An -v -t x1 -- "$file" 2>/dev/null | grep -q '\<00\>'; then issue "$EXIT_RISK" RISK "二進位檔案未掃描：$rel"; return; fi
  # 僅辨識規則與位置；不輸出該值、URL 或原始行。
  local secret_pattern='(^|[[:space:]])(api[_-]?key|secret|token|password|authorization)[[:space:]]*[:=][[:space:]]*[^[:space:]#]{8,}|'
  secret_pattern+='authorization'
  secret_pattern+=':[[:space:]]*[^[:space:]]{8,}'
  if grep -Ein "$secret_pattern" -- "$file" >/dev/null 2>&1; then
    line=$(grep -Ein -m1 "$secret_pattern" -- "$file" | cut -d: -f1); issue "$EXIT_RISK" RISK "疑似機密內容：$rel:$line（內容已遮蔽）"
  fi
  if grep -Ein '(-----BEGIN (RSA |OPENSSH )?PRIVATE KEY-----|\[REDACTED PRIVATE KEY\])' -- "$file" >/dev/null 2>&1; then
    line=$(grep -Ein -m1 '(-----BEGIN (RSA |OPENSSH )?PRIVATE KEY-----|\[REDACTED PRIVATE KEY\])' -- "$file" | cut -d: -f1); issue "$EXIT_RISK" RISK "私鑰標頭：$rel:$line（內容已遮蔽）"
  fi
  if grep -Ein 'https?://[^[:space:]@/]+:[^[:space:]@/]+@[^[:space:]/]+' -- "$file" >/dev/null 2>&1; then
    line=$(grep -Ein -m1 'https?://[^[:space:]@/]+:[^[:space:]@/]+@[^[:space:]/]+' -- "$file" | cut -d: -f1); issue "$EXIT_RISK" RISK "含認證 URL：$rel:$line（內容已遮蔽）"
  fi
}
check_root_dependencies() {
  [[ -e node_modules || -L node_modules ]] || return 0
  if [[ -L node_modules || ! -d node_modules ]]; then
    issue "$EXIT_RISK" RISK 'root node_modules 必須為 physical directory'
    return
  fi
  if (( ! EXISTING_REPO )) || ! git check-ignore -q --no-index -- node_modules/; then
    issue "$EXIT_RISK" RISK 'root node_modules 必須被 Git ignore'
  fi
  local tracked
  if ! tracked=$(git ls-files -- node_modules 2>/dev/null); then
    issue "$EXIT_RISK" RISK 'root node_modules tracked state 無法驗證'
  elif [[ -n $tracked ]]; then
    issue "$EXIT_RISK" RISK 'root node_modules 含 tracked contents'
  fi
  if ! command -v python3 >/dev/null 2>&1; then
    issue "$EXIT_RISK" RISK 'dependency policy validator unavailable'
    return
  fi
  local result
  if ! result=$(python3 - <<'PY'
